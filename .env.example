# Cloud sync is optional. Without these two, Notekeeper is local-only and ships
# no account or sync code. Copy this file to .env.local to turn it on.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Show "Continue with Google" (enable the Google provider in Supabase first).
# VITE_AUTH_GOOGLE=true
